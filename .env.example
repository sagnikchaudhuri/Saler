# SalesSim — environment variable template
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
#
# IMPORTANT SECURITY NOTES
# - These are SERVER-SIDE secrets. They must NOT be prefixed with VITE_,
#   because any VITE_ variable is bundled into the browser and becomes public.
# - The browser calls our own serverless API routes; those routes read these
#   values and call the external services. The keys never reach the client.

# --- LLM provider (optional; Demo Mode works without it) ---------------------
# Used by the AI customer persona and the evaluator (added in later phases).
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=

# --- ElevenLabs text-to-speech (Phase 6; optional) --------------------------
# Server-side only. Leave blank to fall back to browser speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
