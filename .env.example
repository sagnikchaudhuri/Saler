# Saler — environment variable template
# Copy to ".env.local" for local development. NEVER commit a real .env file.
#
# SECURITY
# - Every variable here is SERVER-SIDE ONLY. None is prefixed with VITE_,
#   because any VITE_ variable is inlined into the browser bundle and becomes
#   public. The client never reads environment variables at all — it only ever
#   calls same-origin /api/* routes.
# - On Vercel, set these in Project Settings → Environment Variables.
#
# EVERYTHING BELOW IS OPTIONAL.
# With no variables set, Saler runs fully in Demo Mode: deterministic customer,
# deterministic scoring, deterministic final report, and browser/silent voice.

# --- AI customer + evaluators (optional) ------------------------------------
# Enables the live AI customer, turn evaluator, and final review. Without it,
# all three fall back independently to their deterministic implementations.
OPENAI_API_KEY=

# Optional: point at an OpenAI-compatible gateway. Defaults to
# https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: chat model used for all three AI routes. Defaults to gpt-4o-mini.
LLM_MODEL=

# --- AI route protection (optional, but set it in production) ----------------
# When set, the AI routes require a short-lived, server-signed capability token
# (issued from same-origin GET /api/ai-capability). The secret never leaves the
# server and is never a VITE_ value. With no secret, Demo Mode and local dev
# work with zero setup; the routes stay same-origin + rate-limited but do not
# require a token. Set this WHENEVER OPENAI_API_KEY is set on a public deploy.
# Use a long random value, e.g. `openssl rand -hex 32`.
AI_CAPABILITY_SECRET=

# --- ElevenLabs voice output (optional) -------------------------------------
# Enables premium customer speech. Without BOTH values the app falls back to
# the browser voice, then to Silent Mode.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
